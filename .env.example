# Optional configuration. A local static scan needs no API key or login.
TEAM_MODE=false
WORKSPACE_PASSWORD=
# Team mode requires a random secret of at least 32 characters.
SESSION_SECRET=
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Model is selected explicitly in Settings. Exact provider model ID; no GPT_* enum.
AI_PROVIDER=ollama
AI_MODEL=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Server-side token for private GitHub archive ingestion; never sent to scanner.
GITHUB_TOKEN=

API_PORT=8000
UI_PORT=3000
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_SIZE=52428800
MAX_EXPANDED_SIZE=524288000
MAX_FILES_PER_JOB=10000
JOB_RETENTION_DAYS=7
REPORT_RETENTION_DAYS=30
