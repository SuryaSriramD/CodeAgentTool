# Server-only upstream URL. Browser requests use the same-origin /api/backend proxy.
# Native backend: http://127.0.0.1:8000
# Compose backend: http://backend:8080
API_URL=http://127.0.0.1:8000
# Allowed public browser origins, comma-separated. Include the actual UI host/port.
PUBLIC_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
